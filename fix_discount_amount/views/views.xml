<odoo>
    <record id="view_order_form_inherit_fixed_discount" model="ir.ui.view">
        <field name="name">sale.order.form.fixed.discount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='discount']" position="before">
                <field name="discount_fixed" widget="monetary" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_fixed_discount" model="ir.ui.view">
        <field name="name">account.move.form.fixed.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='discount']" position="before">
                <field name="discount_fixed" widget="monetary" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>