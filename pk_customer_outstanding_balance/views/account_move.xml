<odoo>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit.outstanding</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='o_col']" position="after">
                <label for="outstanding_balance"/>
                <div name="outstanding_balance">
                    <field name="outstanding_balance" readonly="1" widget="monetary"
                           options="{'currency_field': 'currency_id'}" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
